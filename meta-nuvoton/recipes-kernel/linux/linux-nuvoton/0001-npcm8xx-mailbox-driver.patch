From 34f0a813d0d4dfe21e29fca5f35fc9be832ff00b Mon Sep 17 00:00:00 2001
From: Tyrone Ting <kfting@nuvoton.com>
Date: Fri, 17 Jun 2022 14:09:07 +0800
Subject: [PATCH] npcm8xx mailbox driver

Signed-off-by: Tyrone Ting <kfting@nuvoton.com>
---
 .../dts/nuvoton/nuvoton-common-npcm8xx.dtsi   |   9 +
 .../boot/dts/nuvoton/nuvoton-npcm845-evb.dts  |  35 +-
 drivers/mailbox/Kconfig                       |   7 +
 drivers/mailbox/Makefile                      |   2 +
 drivers/mailbox/npcm8xx-mailbox.c             | 431 ++++++++++++++++++
 5 files changed, 483 insertions(+), 1 deletion(-)
 create mode 100644 drivers/mailbox/npcm8xx-mailbox.c

diff --git a/arch/arm64/boot/dts/nuvoton/nuvoton-common-npcm8xx.dtsi b/arch/arm64/boot/dts/nuvoton/nuvoton-common-npcm8xx.dtsi
index 53d4c69c3ee0..047ec4170cd0 100644
--- a/arch/arm64/boot/dts/nuvoton/nuvoton-common-npcm8xx.dtsi
+++ b/arch/arm64/boot/dts/nuvoton/nuvoton-common-npcm8xx.dtsi
@@ -339,6 +339,15 @@
 			status = "disabled";
 		};
 
+		mailbox0: mailbox@f080c000 {
+			compatible = "nuvoton,npcm845-mailbox";
+			reg = <0x0 0xf080c000 0x0 0x10>;
+			interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <1>;
+			mbox-name = "a9";
+			status = "disabled";
+		};
+
 		m4_rproc: m4@0 {
 			compatible = "nuvoton,npcm845-m4";
 			reg = <0x0 0x0 0x0 0x0>;
diff --git a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
index b1b15c3aea00..8505e84937f5 100644
--- a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
+++ b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
@@ -92,10 +92,35 @@
 		};
 
 		cp1_tag: cp1_tag@0x36000000  {
+			compatible = "shared-dma-pool";
 			reg = <0x0 0x36000000  0x0 0x100000>;
 			no-map;
 		};
 
+		vdev0vring0: vdev0vring0@0x36100000  {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x36100000  0x0 0x1000>;
+			no-map;
+		};
+
+		vdev0vring1: vdev0vring1@0x36101000  {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x36101000  0x0 0x1000>;
+			no-map;
+		};
+
+		vdev0buffer: vdev0buffer@0x36102000  {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x36102000  0x0 0x4000>;
+			no-map;
+		};
+
+		rtbuffer: rtbuffer@0x36106000  {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x36106000  0x0 0x1000>;
+			no-map;
+		};
+
 	};
 
 	regulators {
@@ -712,8 +737,16 @@
   status = "okay";
 };
 
+&mailbox0 {
+  status = "okay";
+};
+
 &m4_rproc {
 	status = "okay";
-	memory-region = <&cp1_tag>;
+	memory-region = <&cp1_tag>, <&vdev0vring0>, <&vdev0vring1>,
+                        <&vdev0buffer>, <&rtbuffer>;
+	#mbox-cells = <1>;
+	mbox-names = "vq0", "vq1";
+	mboxes = <&mailbox0 0>, <&mailbox0 1>;
 };
 
diff --git a/drivers/mailbox/Kconfig b/drivers/mailbox/Kconfig
index 05b1009e2820..b8acee24c246 100644
--- a/drivers/mailbox/Kconfig
+++ b/drivers/mailbox/Kconfig
@@ -254,4 +254,11 @@ config QCOM_IPCC
 	  acts as an interrupt controller for receiving interrupts from clients.
 	  Say Y here if you want to build this driver.
 
+config NPCM8XX_MBOX
+	tristate "NPCM8XX MAILBOX"
+	depends on ARCH_NPCM && OF
+	help
+	  Mailbox implementation for Nuvoton NPCM8XX family chips with
+	  hardware for interprocessor communication.
+
 endif
diff --git a/drivers/mailbox/Makefile b/drivers/mailbox/Makefile
index 2e06e02b2e03..de7cf1b9bc34 100644
--- a/drivers/mailbox/Makefile
+++ b/drivers/mailbox/Makefile
@@ -54,3 +54,5 @@ obj-$(CONFIG_SUN6I_MSGBOX)	+= sun6i-msgbox.o
 obj-$(CONFIG_SPRD_MBOX)		+= sprd-mailbox.o
 
 obj-$(CONFIG_QCOM_IPCC)		+= qcom-ipcc.o
