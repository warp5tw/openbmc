@@ -79,15 +80,12 @@ void interruptFlightRecorderCallBack(Signal& /*signal*/,
 }
 
 static std::optional<Response>
-    processRxMsg(const std::vector<uint8_t>& requestMsg, Invoker& invoker,
+    processRxMsg(uint8_t eid, const std::vector<uint8_t>& requestMsg, Invoker& invoker,
                  requester::Handler<requester::Request>& handler,
