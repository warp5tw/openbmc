diff --git a/pldmd/pldmd.cpp b/pldmd/pldmd.cpp
index 9f5bbaae0..d6dfb448a 100644
--- a/pldmd/pldmd.cpp
+++ b/pldmd/pldmd.cpp
@@ -13,6 +13,7 @@
 #include <libpldm/bios.h>
